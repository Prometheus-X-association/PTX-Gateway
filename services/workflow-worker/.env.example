# Backend-only values. Never use VITE_ prefixes for these credentials.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Set the SAME two secrets on Supabase functions and every workflow worker.
# Generate each independently, e.g. openssl rand -base64 32
WORKFLOW_SECRETS_KEY=replace-with-32-base64-encoded-bytes
WORKFLOW_INTERNAL_SECRET=replace-with-a-random-secret
# Public origin serving the standalone /workflow/respond page; match the functions value.
WORKFLOW_INTERACTION_BASE_URL=https://gateway.example.com
# Deployment capacity per worker process; no per-workflow or organization cap.
WORKFLOW_WORKER_CONCURRENCY=4
# Optional override when the function gateway has a separate internal address.
# WORKFLOW_FUNCTIONS_URL=http://host.docker.internal:54321/functions/v1
