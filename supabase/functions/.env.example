# public url for Gateway as Provider (OIDC)
OIDC_PUBLIC_BASE_URL=http://localhost:54321

# Backend workflow execution. Configure the same secrets on every workflow worker.
# Generate each independently with: openssl rand -base64 32
# WORKFLOW_SECRETS_KEY must decode to exactly 32 bytes.
WORKFLOW_SECRETS_KEY=
WORKFLOW_INTERNAL_SECRET=

# Public origin hosting the standalone /workflow/respond page.
WORKFLOW_INTERACTION_BASE_URL=https://gateway.example.com
